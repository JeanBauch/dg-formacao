# Inventory of environment variables. Copy to .env.local for local development.
# Every value is empty or a fictitious value for the local environment; real
# values live in the host's encrypted variables and in the GitHub Actions secrets.

# Application environment: local, ci, staging or production. No default.
APP_ENV=local

# Public sign-up switch: exactly true or false. No default.
SIGNUP_ENABLED=true

# Postgres connection as the application role, dg_app (transaction pooler in
# hosted environments). Hosted environments must require TLS (sslmode=require).
# Locally, the container from `pnpm db:up`, set up by the roles script
# (scripts/db-roles.mts) and the migrations.
DATABASE_URL=postgresql://dg_app:dg_app@localhost:5432/dg_formacao

# E-mail adapter: file (local and ci only) or resend. The file adapter sends
# nothing out: it leaves each message in the .mailbox folder.
MAILER_ADAPTER=file

# The Resend adapter's API key (a secret) and sender, such as
# Name <address@domain>. Both are required when MAILER_ADAPTER is resend, and
# stay empty with the file adapter.
RESEND_API_KEY=
MAILER_FROM=

# Defined by Vercel at build and run time; leave empty here. A non-empty value
# is refused when APP_ENV is local or ci.
VERCEL=

# Cap of new rows a day in the security log, a whole number from 1 to 2000
# (default 1000). Above it, new events go to overflow rows. A larger cap needs
# a new storage budget first (RNF-SEG-15).
SECURITY_EVENTS_DAILY_CAP=1000
